data = [
    ['High', 'Yes', 'No', 'Yes'],
    ['High', 'Yes', 'No', 'Yes'],
    ['Low', 'No', 'Yes', 'No'],
    ['High', 'Yes', 'Yes', 'Yes']
]

hypothesis = None

for row in data:
    if row[-1] == 'Yes':
        if hypothesis is None:
            hypothesis = row[:-1].copy()
        else:
            for i in range(len(hypothesis)):
                if hypothesis[i] != row[i]:
                    hypothesis[i] = '?'

print("Final Hypothesis:", hypothesis)
